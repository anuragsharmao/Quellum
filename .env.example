# Copy to .env (or set in your host's dashboard). Nothing here is ever sent to the browser.
QUELLUM_ENV=development                 # production => Secure cookies by default
QUELLUM_DATA_DIR=./data                 # SQLite file + private PDF folder. MUST be a persistent disk in production.

# ---- cookies / CORS ---------------------------------------------------------------
# Same origin (backend serves the frontend, the default): leave SAMESITE=lax and CORS_ORIGINS empty/default.
# Frontend and API on different sites (e.g. app.example.com + api.other.com): SAMESITE=none, SECURE=true, list the exact frontend origin.
QUELLUM_COOKIE_SECURE=false             # true on HTTPS
QUELLUM_COOKIE_SAMESITE=lax             # lax | strict | none
QUELLUM_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5500,http://127.0.0.1:5173,http://127.0.0.1:3000,http://127.0.0.1:5500
QUELLUM_SERVE_FRONTEND=true
QUELLUM_FRONTEND_DIR=../frontend

# ---- retention --------------------------------------------------------------------
QUELLUM_EXPIRATION_DAYS=30              # inactivity period (tests use a fraction of a day)
QUELLUM_ORPHAN_DOC_TTL_HOURS=24         # uploaded but never used in a conversation
QUELLUM_CLEANUP_INTERVAL_MINUTES=60     # in-process scheduler; 0 = disabled (use the cron job / `python -m app.cleanup_cli`)

# ---- limits -----------------------------------------------------------------------
QUELLUM_MAX_UPLOAD_MB=20
QUELLUM_MAX_PDF_PAGES=300
QUELLUM_MAX_TEXT_CHARS=200000
QUELLUM_MAX_STORAGE_MB=100
QUELLUM_MAX_CONVERSATIONS=100
QUELLUM_UPLOADS_PER_HOUR=20
QUELLUM_MESSAGES_PER_10MIN=30

# ---- retrieval --------------------------------------------------------------------
QUELLUM_EMBEDDER=sbert                  # sbert (all-MiniLM-L6-v2, shared with the detector) | hashing (dev only, weaker)
QUELLUM_TOP_K=5

# ---- answer generation: Groq primary, Gemini fallback --------------------------------
GROQ_API_KEY=                            # required for Groq; use a free-tier Groq key
GEMINI_API_KEY=                          # optional; fallback is called only when Groq fails
QUELLUM_LLM_PROVIDER=groq
QUELLUM_LLM_MODEL=llama-3.1-8b-instant
QUELLUM_LLM_FALLBACK_PROVIDER=gemini
QUELLUM_LLM_FALLBACK_MODEL=gemini-2.5-flash
QUELLUM_LLM_TIMEOUT_S=30
QUELLUM_LLM_MAX_PROMPT_CHARS=12000       # bounds input size while retaining the question
# Legacy provider options: openai_compatible | anthropic, with QUELLUM_LLM_API_KEY.
QUELLUM_LLM_BASE_URL=https://api.openai.com/v1

# ---- hallucination detector ensemble ------------------------------------------------
QUELLUM_DETECTOR_SEEDS=0,1,2,3,4,5,6,7  # seeds 8,9 can be selected as alternatives
